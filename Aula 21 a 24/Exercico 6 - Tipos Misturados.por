programa {
  funcao inicio() {
    cadeia produto 
    inteiro codigo
    real preco
    logico disponivel

    produto = "Tamanduá"
    
    codigo = 1000
    preco = 20.99
    disponivel = verdadeiro

    escreva ("produto: ", produto, "\n")
    escreva ("codigo: ", codigo, "\n")
    escreva ("preco: ", preco, "\n")
    escreva ("esta disponivel: ", disponivel, "\n")
  }
}
