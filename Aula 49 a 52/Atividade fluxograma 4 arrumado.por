programa {
  funcao inicio() {
    cadeia nome
    inteiro contador = 0, quantidade

    escreva("Digite seu nome: ")
    leia(nome)

    escreva("Digite a quantidade de vezes que você deseja repitir: ")
    leia(quantidade)

    para (inteiro i = 1; i <= quantidade; i++ )
    {
      escreva("O nome do usuário é: ",nome ,"\n")
      
    }
  }
}
