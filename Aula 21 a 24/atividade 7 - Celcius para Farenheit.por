programa {
  funcao inicio() {
    real grausCelsius, conversaoDeTemperatura

    escreva("Qual temperatura em graus celcius você deseja converter para farenheit? ")
    leia(grausCelsius)

    conversaoDeTemperatura = (9 * grausCelsius + 160)/5

    escreva("A conversão de celcius para farenheit é igual a: ", conversaoDeTemperatura)

    

  }
}
